{
  "name": "tiny-app",
  "version": "2.2.0",
  "description": "一款基于 Tauri 的本地文件优化工作台，支持 TinyPNG 图片压缩、音频压缩与任务记录",
  "author": {
    "name": "taosiqi",
    "email": "hksiqijson@gmail.com"
  },
  "homepage": "https://github.com/taosiqi/tiny-app",
  "scripts": {
    "format": "prettier --write .",
    "lint": "eslint --cache .",
    "test": "vitest run",
    "test:frontend": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:build": "vite build",
    "test:e2e": "playwright test",
    "test:fixtures": "node scripts/create-test-fixtures.mjs",
    "prepare:ffmpeg": "node scripts/prepare-ffmpeg-resource.mjs",
    "test:smoke": "pnpm test:fixtures && cargo test --manifest-path src-tauri/Cargo.toml smoke_",
    "test:desktop:e2e": "pnpm test:fixtures && node desktop-e2e/run.mjs",
    "test:all": "pnpm lint && pnpm test:frontend && pnpm test:rust && pnpm test:build",
    "dev": "tauri dev",
    "build": "tauri build",
    "vite:dev": "vite --host 127.0.0.1",
    "vite:build": "pnpm prepare:ffmpeg && vite build",
    "preview": "vite preview",
    "build:mac": "tauri build --bundles app,dmg",
    "build:win": "tauri build --bundles nsis",
    "build:linux": "tauri build --bundles deb,appimage",
    "build:mac:arm64": "tauri build --target aarch64-apple-darwin --bundles app,dmg",
    "build:mac:x64": "tauri build --target x86_64-apple-darwin --bundles app,dmg"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-dialog": "^2.4.1",
    "keepalive-for-react": "^5.0.7",
    "keepalive-for-react-router": "^2.0.3",
    "prop-types": "^15.8.1",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.13.1",
    "react-zoom-pan-pinch": "^3.7.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@tauri-apps/cli": "^2.9.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@playwright/test": "^1.57.0",
    "@unocss/reset": "^66.6.2",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "ffmpeg-static": "^5.3.0",
    "globals": "^16.5.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.7.4",
    "unocss": "^66.6.2",
    "vite": "^7.2.6",
    "vitest": "^4.1.7"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@swc/core",
      "esbuild",
      "ffmpeg-static"
    ]
  },
  "packageManager": "pnpm@10.10.0+sha512.d615db246fe70f25dcfea6d8d73dee782ce23e2245e3c4f6f888249fb568149318637dca73c2c5c8ef2a4ca0d5657fb9567188bfab47f566d1ee6ce987815c39"
}
