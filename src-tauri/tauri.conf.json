{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "TinyPress",
  "version": "../package.json",
  "identifier": "com.taosiqi.tiny-app",
  "build": {
    "beforeDevCommand": "pnpm vite:dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "pnpm vite:build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "TinyPress",
        "width": 1280,
        "height": 860,
        "minWidth": 900,
        "minHeight": 640,
        "backgroundColor": "#fbfbfb",
        "titleBarStyle": "Transparent",
        "hiddenTitle": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": ["../node_modules/ffmpeg-static/ffmpeg"]
  }
}
